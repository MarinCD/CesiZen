generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  VISITEUR
  UTILISATEUR
  ADMINISTRATEUR
}

enum TypeRetourUtilisateur {
  PROPOSITION
  ANOMALIE
}

enum StatutRetourUtilisateur {
  NOUVEAU
  EN_COURS
  TRAITE
}

model Utilisateur {
  id                  Int       @id @default(autoincrement())
  nom                 String?
  prenom              String?
  email               String    @unique
  motDePasse          String
  role                Role      @default(UTILISATEUR)
  dateCreation        DateTime  @default(now())
  derniereActivite    DateTime  @default(now())
  consentementRGPD    Boolean   @default(false)
  // Invalide les jetons de session émis avant cette date (cf. callback jwt).
  motDePasseModifieLe DateTime?

  informations        Information[]
  questionnaires      Questionnaire[]
  resultatsDiagnostic ResultatDiagnostic[]
  trackerEmotions     TrackerEmotion[]
  retoursUtilisateur  RetourUtilisateur[]

  @@map("utilisateur")
}

model Information {
  id              Int         @id @default(autoincrement())
  titre           String
  texte           String      @db.Text
  categorie       String?
  datePublication DateTime?
  idCreateur      Int
  createur        Utilisateur @relation(fields: [idCreateur], references: [id], onDelete: Cascade)

  @@map("information")
}

model Questionnaire {
  id           Int          @id @default(autoincrement())
  titre        String
  description  String?      @db.Text
  dateCreation DateTime     @default(now())
  idCreateur   Int
  createur     Utilisateur  @relation(fields: [idCreateur], references: [id], onDelete: Cascade)
  questions    Question[]
  diagnostics  Diagnostic[]

  @@map("questionnaire")
}

model Diagnostic {
  id              Int                  @id @default(autoincrement())
  nom             String
  description     String?              @db.Text
  questionnaireId Int
  questionnaire   Questionnaire        @relation(fields: [questionnaireId], references: [id], onDelete: Cascade)
  questions       Question[]
  resultats       ResultatDiagnostic[]

  @@map("diagnostic")
}

model Question {
  id              Int            @id @default(autoincrement())
  texte           String
  pointsAssocies  Int
  questionnaireId Int?
  diagnosticId    Int?
  questionnaire   Questionnaire? @relation(fields: [questionnaireId], references: [id], onDelete: SetNull)
  diagnostic      Diagnostic?    @relation(fields: [diagnosticId], references: [id], onDelete: SetNull)
  reponses        Reponse[]

  @@map("question")
}

model Reponse {
  id         Int      @id @default(autoincrement())
  texte      String
  valeur     Int
  questionId Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("reponse")
}

model ResultatDiagnostic {
  id              Int         @id @default(autoincrement())
  dateRealisation DateTime    @default(now())
  score           Int
  interpretation  String?
  utilisateurId   Int
  diagnosticId    Int
  utilisateur     Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)
  diagnostic      Diagnostic  @relation(fields: [diagnosticId], references: [id], onDelete: Cascade)

  @@map("resultat_diagnostic")
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  action    String
  actorId   Int?
  targetId  Int?
  ip        String?
  metadata  String?  @db.Text
  createdAt DateTime @default(now())

  @@index([actorId])
  @@index([targetId])
  @@index([action])
  @@map("audit_log")
}

// Compteurs persistants partagés entre toutes les instances applicatives.
// La clé est un HMAC de la route et de l'adresse IP : aucune IP brute n'est stockée.
model RateLimitAttempt {
  id        Int      @id @default(autoincrement())
  keyHash   String   @db.VarChar(64)
  createdAt DateTime @default(now())

  @@index([keyHash, createdAt])
  @@map("rate_limit_attempt")
}

model TrackerEmotion {
  id            Int         @id @default(autoincrement())
  emotion       String
  intensite     Int
  note          String?     @db.Text
  date          DateTime    @default(now())
  utilisateurId Int
  utilisateur   Utilisateur @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@map("tracker_emotion")
}

model RetourUtilisateur {
  id            Int                     @id @default(autoincrement())
  type          TypeRetourUtilisateur
  estBloquant   Boolean                 @default(false)
  emplacement   String
  pageUrl       String?                 @db.VarChar(500)
  description   String                  @db.Text
  statut        StatutRetourUtilisateur @default(NOUVEAU)
  dateCreation  DateTime                @default(now())
  dateMiseAJour DateTime                @updatedAt
  utilisateurId Int?
  utilisateur   Utilisateur?            @relation(fields: [utilisateurId], references: [id], onDelete: Cascade)

  @@index([statut, dateCreation])
  @@index([type, estBloquant])
  @@index([utilisateurId])
  @@map("retour_utilisateur")
}
