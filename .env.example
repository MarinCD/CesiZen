# Base MySQL de l'environnement courant (ne jamais committer de vrais identifiants)
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Générer trois secrets DIFFÉRENTS, un jeu par environnement :
#   openssl rand -base64 48
# ou : npm run security:configure-env -- --rotate
# NEXTAUTH_SECRET signe les sessions : une valeur devinable permet de forger un
# jeton administrateur. L'application refuse de démarrer en production si elle
# détecte une valeur faible.
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="https://staging.example.fr"
RATE_LIMIT_HMAC_KEY="change-me"
AUDIT_HMAC_KEY="change-me"

# Nombre de proxys de confiance qui ajoutent leur valeur à X-Forwarded-For
# (1 = Cloudflare seul, 2 = Cloudflare + reverse proxy local…). Sert à lire
# l'IP cliente sans se fier à la partie falsifiable de l'en-tête.
TRUSTED_PROXY_HOPS="1"

# Laisser à 0 tant que l'hébergement des résultats de diagnostic n'est pas HDS.
HDS_COMPLIANT_STORAGE="0"

# À 1 uniquement pour tester volontairement le rate-limit hors production.
RATE_LIMIT_ENABLED="0"
